/*
 * Nextflow configuration for the nf-biolm workflow collection.
 *
 * Backed by `biolm-sdk` (`import biolm`, `biolm` CLI, `BIOLM_TOKEN`).
 * Protocols are NOT forked here — they are read from the shared
 * biolm-protocols catalog (see params.protocols_root below).
 */

params {
  // --- Auth -----------------------------------------------------------
  token  = params.token ?: (System.getenv('BIOLM_TOKEN') ?: System.getenv('BIOLMAI_TOKEN')) ?: ''

  // --- Backend: where model inference actually executes ----------------
  // 'platform' -> hosted biolm.ai API (default)
  // 'hub'      -> a local/self-hosted biolm-hub gateway at params.hub_url
  backend  = 'platform'
  hub_url  = 'http://127.0.0.1:8000'

  // --- Execution: how protocols are orchestrated ------------------------
  // 'local'  -> `biolm protocol run-local` (default; honors the hub switch)
  // 'hosted' -> `biolm protocol run <slug>` (orchestration stays on platform)
  execution = 'local'

  // --- In-repo protocol catalog (catalog.json + protocols/ + fixtures/) --
  protocols_root = System.getenv('BIOLM_PROTOCOLS_ROOT') ?: '.'

  // --- Demo / smoke-test mode -------------------------------------------
  // When true, workflows use a cheap local mock in place of live BioLM
  // calls, so `--demo` never needs a token or network access.
  demo = false

  // --- Common I/O ---------------------------------------------------------
  input  = ''          // optional FASTA override (structure_predict, parallel_fold_farm)
  outdir = 'results'

  // --- structure_predict -------------------------------------------------
  structure_model = 'esmfold'   // or 'boltz-2'
  boltz2          = false       // shorthand: --boltz2 forces structure_model=boltz-2

  // --- parallel_fold_farm --------------------------------------------------
  max_forks = 4

  // --- library_screen -------------------------------------------------------
  min_plddt = 0
  top_n     = 10

  // --- trickle_screen ------------------------------------------------------
  rounds          = 3
  survivors       = 2
  new_per_round   = 2

  // --- sat_mut_stability -----------------------------------------------------
  wildtype     = ''      // if set, auto-enumerate a saturation library instead of using the fixture
  max_variants = 40

  // --- legacy antibody_engineering params (kept for backward compatibility)
  num_variants   = 100
  sampling_temp  = 0.8
}

process {
  executor     = 'local'
  cpus         = 1
  memory       = '2 GB'
  // Nextflow only auto-adds `<projectDir>/bin` to PATH, where projectDir is
  // the *main script's* directory. Since several catalog entrypoints live
  // under workflows/*.nf (not the repo root), explicitly prepend the repo
  // root's bin/ (biolm CLI wrappers + mock generators) so every entrypoint
  // — root wrappers and workflows/*.nf alike — can find them. Assumes
  // `nextflow run ...` is invoked from the nf-biolm repo root (see README).
  beforeScript = "export PATH=\"${System.getProperty('user.dir')}/bin:\$PATH\""
}
